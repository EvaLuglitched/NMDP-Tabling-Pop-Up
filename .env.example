# ---------------------------------------------------------------------------
# Copy this file to .env for local development.
# On Vercel, set the same keys under Project Settings -> Environment Variables.
# ---------------------------------------------------------------------------

# REQUIRED. Postgres connection string. Without it the app still runs, but
# every visit and pledge is kept in memory only and is lost within minutes.
# Works with Vercel Postgres, Neon, Supabase, or any Postgres provider.
# Supabase: use the "Connection pooling" / Transaction mode URI (port 6543).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# REQUIRED. Password for the analytics dashboard. Protects the student pledge
# roster and the clear-data / export endpoints. Pick a long random string --
# anyone with the campaign URL can reach the dashboard page itself.
ADMIN_TOKEN="choose-a-long-random-string"

# OPTIONAL. Enables AI-written assignment reflections. Without it the app falls
# back to a well-written template that still uses the real campaign numbers.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
